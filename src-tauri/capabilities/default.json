{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "enables the default permissions",
  "windows": [
    "main",
    "tray-panel"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-close",
    "opener:default",
    "opener:allow-open-path",
    "opener:allow-reveal-item-in-dir",
    "notification:default",
    "updater:default",
    "process:default"
  ]
}
