# =============================================================================
# pre-commit · 本地提交前质量门禁（husky v9）
#
# 背景：rc.46 发版时 CI 的 typecheck 才发现两处类型错误（本地 vue-tsc
# 用的 tsconfig 口径与 CI 不同 + 未跑同口径检查）——问题本应在提交前拦住。
# 本钩子把 CI 门禁的前两项（typecheck + lint）前移到本地提交时。
#
# 行为：
#   · typecheck（vue-tsc -p tsconfig.app.json，与 CI pnpm typecheck 同口径）
#   · lint（eslint src，与 CI pnpm lint 同口径）
#   · 任一失败 → 提交被阻止（exit 1）
#
# 说明：
#   · typecheck 依赖 auto-imports.d.ts / components.d.ts（构建期生成物，
#     跑过一次 dev/build 就会存在）；文件缺失时先自动 pnpm build 生成。
#     如果 build 也失败（如依赖未安装），请先 pnpm install 排查后再提交。
#   · 依赖未安装（node_modules 缺失）时跳过检查并提示 —— 钩子不应把
#     "还没装依赖的干净环境"卡死，此时 CI 会兜底把关。
#   · 特殊情况确需跳过：git commit --no-verify（不推荐，CI 仍会拦截）。
# =============================================================================
# 依赖未安装时跳过（给出明确提示，不静默 —— 让用户知道这次提交没过门禁）
if [ ! -d node_modules ]; then
  echo "[pre-commit] 未检测到 node_modules，跳过本地检查（提交前请先 pnpm install 并手动跑 pnpm typecheck / pnpm lint）"
  exit 0
fi

# typecheck 前置：构建期生成的 d.ts 缺失时先 build 一次（干净克隆直跑
# typecheck 必报 TS2304 —— 见 .cnb.yml 硬约束 2 的注释）
if [ ! -f auto-imports.d.ts ] || [ ! -f components.d.ts ]; then
  echo "[pre-commit] 缺少构建期生成的 d.ts，先执行 pnpm build 生成……"
  pnpm build >/dev/null || {
    echo "[pre-commit] pnpm build 失败，请先本地排查（通常为依赖未装全或代码有语法错误）"
    exit 1
  }
fi

echo "[pre-commit] 运行 typecheck……"
pnpm typecheck || {
  echo "[pre-commit] typecheck 未通过，提交已阻止。修复后重试，或 git commit --no-verify 跳过（不推荐）"
  exit 1
}

echo "[pre-commit] 运行 lint……"
pnpm lint || {
  echo "[pre-commit] lint 未通过，提交已阻止。可运行 pnpm lint --fix 自动修复后重试"
  exit 1
}

echo "[pre-commit] 检查通过 ✓"
