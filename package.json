{
  "name": "wocnb",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "prepare": "command -v vp >/dev/null 2>&1 && vp config --hooks --no-agent </dev/null || echo '[prepare] 未检测到 vp（vite-plus），跳过 Git 钩子安装 —— 提交前请手动跑 pnpm typecheck / pnpm lint'",
    "tauri": "tauri",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint src --cache --cache-strategy content --cache-location node_modules/.cache/eslint/.eslintcache",
    "typecheck": "vue-tsc -p ./tsconfig.app.json --incremental",
    "test": "vitest run"
  },
  "dependencies": {
    "@iconify/vue": "5.0.3",
    "@internationalized/date": "^3.12.4",
    "@nuxt/ui": "^4.12.0",
    "@tanstack/charts": "^1.1.0",
    "@tanstack/table-core": "^8.21.3",
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-notification": "^2.7.0",
    "@tauri-apps/plugin-opener": "^2.7.2",
    "@tauri-apps/plugin-process": "^2.4.0",
    "@tauri-apps/plugin-updater": "^2.14.1",
    "@unhead/vue": "^3.4.3",
    "@vueuse/core": "^14.4.0",
    "date-fns": "^4.4.0",
    "dompurify": "^3.4.17",
    "marked": "^18.1.1",
    "scule": "^1.3.0",
    "shiki": "^4.5.0",
    "tailwindcss": "^4.3.3",
    "vue": "^3.5.44",
    "vue-i18n": "^11.4.16",
    "vue-router": "^5.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.4",
    "@vitejs/plugin-vue": "^6.0.10",
    "eslint": "^10.13.0",
    "eslint-plugin-better-tailwindcss": "^4.9.1",
    "eslint-plugin-vue": "^10.11.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4",
    "vite-plugin-vue-layouts": "^0.11.0",
    "vitest": "^5.0.5",
    "vue-tsc": "^3.3.13"
  },
  "packageManager": "pnpm@12.14.0",
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "26.13.1",
      "onFail": "download"
    }
  }
}
